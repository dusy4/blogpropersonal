---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Share from '../components/Share.astro';
import { SITE_URL, TELEGRAM_CHANNEL_URL } from '../config';

interface Props {
  title: string;
  slug: string;
  description: string;
  date?: Date;
  client?: string;
  result?: string;
  image?: string;
}

const { title, slug, description, date, client, result, image } = Astro.props;
const path = `/cases/${slug}`;
const canonical = new URL(path, SITE_URL).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: canonical,
  mainEntityOfPage: canonical,
  ...(date ? { datePublished: date.toISOString() } : {}),
  ...(image ? { image } : {}),
};
---
<Layout title={title} description={description} canonicalPath={path} image={image}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonLd)} /></Fragment>
  <Header />
  <main>
    <article class="container-site max-w-3xl py-14 sm:py-20">
      <a href="/#cases" class="text-sm font-semibold text-blue-700">← До кейсів</a>
      <p class="eyebrow mt-8">{client || 'Case study'}</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">{title}</h1>
      <p class="mt-5 text-lg leading-8 text-slate-600">{description}</p>
      {result && <div class="mt-7 rounded-2xl border border-emerald-200 bg-emerald-50 p-5 font-semibold text-emerald-950">{result}</div>}
      <div class="prose prose-slate mt-10 max-w-none prose-headings:scroll-mt-24 prose-a:text-blue-700"><slot /></div>
      <div class="mt-12"><Share title={title} url={canonical} /></div>
      <aside class="mt-10 rounded-2xl bg-slate-950 p-7 text-white">
        <h2 class="text-2xl font-bold">Потрібна схожа автоматизація?</h2>
        <a class="mt-5 inline-flex rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-slate-950" href={TELEGRAM_CHANNEL_URL} target="_blank" rel="noopener noreferrer">Написати в Telegram →</a>
      </aside>
    </article>
  </main>
  <Footer />
</Layout>
