---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Share from '../components/Share.astro';
import { SITE_URL, TELEGRAM_CHANNEL_URL } from '../config';

interface Props {
  title: string;
  slug: string;
  date: Date;
  keyTakeaways: string;
  author: string;
  image?: string;
}

const { title, slug, date, keyTakeaways, author, image } = Astro.props;
const path = `/articles/${slug}`;
const canonical = new URL(path, SITE_URL).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  datePublished: date.toISOString(),
  author: { '@type': 'Organization', name: author },
  mainEntityOfPage: canonical,
  url: canonical,
  description: keyTakeaways,
  ...(image ? { image } : {}),
};
---
<Layout title={title} description={keyTakeaways} canonicalPath={path} image={image}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Header />
  <main>
    <article class="container-site max-w-3xl py-14 sm:py-20">
      <a href="/#articles" class="text-sm font-semibold text-blue-700">← До статей</a>
      <p class="mt-8 text-sm text-slate-500">{date.toLocaleDateString('uk-UA')} · {author}</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">{title}</h1>

      <section class="mt-8 rounded-2xl border border-blue-200 bg-blue-50 p-6" aria-labelledby="key-takeaways">
        <p class="eyebrow">Answer first</p>
        <h2 id="key-takeaways" class="mt-2 text-lg font-bold text-slate-950">Key Takeaways</h2>
        <p class="mt-2 leading-7 text-slate-700">{keyTakeaways}</p>
      </section>

      <div class="prose mt-10 max-w-none">
        <slot />
      </div>

      <div class="mt-12">
        <Share title={title} url={canonical} />
      </div>

      <aside class="mt-10 rounded-2xl bg-slate-950 p-7 text-white">
        <p class="eyebrow !text-blue-300">Next step</p>
        <h2 class="mt-2 text-2xl font-bold">Обговорити AI-інтеграцію</h2>
        <p class="mt-3 max-w-xl text-sm leading-6 text-slate-300">Поставте питання або обговоріть задачу у відкритому Telegram-каналі.</p>
        <a class="mt-5 inline-flex rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-slate-950" href={TELEGRAM_CHANNEL_URL} target="_blank" rel="noopener noreferrer">Відкрити Telegram →</a>
      </aside>
    </article>
  </main>
  <Footer />
</Layout>
