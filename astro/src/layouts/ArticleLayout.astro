---
import Layout from './Layout.astro';
import Share from '../components/Share.astro';
import { TELEGRAM_CHANNEL_URL, SITE_URL } from '../config';

export interface Props {
  title: string;
  date: Date;
  author: string;
  keyTakeaways: string;
  slug: string;
}

const { title, date, author, keyTakeaways, slug } = Astro.props;
const url = `${SITE_URL}/articles/${slug}`;
const dateIso = date.toISOString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  author: { '@type': 'Person', name: author },
  datePublished: dateIso,
  description: keyTakeaways,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};
---

<Layout title={title} description={keyTakeaways}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Fragment slot="header">
    <slot name="header" />
  </Fragment>
  <section class="mx-auto max-w-3xl px-4 py-12 lg:px-8">
    <article class="prose prose-lg max-w-none prose-headings:text-slate-900 prose-a:text-brand">
      <h1 class="text-3xl font-bold leading-tight md:text-5xl">{title}</h1>
      <div class="mt-4 flex items-center gap-3 text-sm text-muted">
        <span>{author}</span>
        <span>•</span>
        <time datetime={dateIso}>{date.toLocaleDateString('uk-UA')}</time>
      </div>

      <div class="my-8 rounded-2xl border-l-4 border-accent bg-amber-50 p-6">
        <h2 class="text-lg font-semibold text-brand">Key Takeaways</h2>
        <p class="mt-2 text-slate-700">{keyTakeaways}</p>
      </div>

      <slot />
    </article>

    <div class="mt-10 rounded-2xl bg-brand p-8 text-white">
      <h3 class="text-xl font-semibold">Приєднуйтесь до нашого Telegram-каналу</h3>
      <p class="mt-2 text-slate-100">Отримуйте новини про AI-інтеграції, кейси та практичні інсайти.</p>
      <a href={TELEGRAM_CHANNEL_URL} target="_blank" rel="noopener" class="btn-primary mt-4">Перейти в Telegram →</a>
    </div>

    <Share url={url} title={title} />
  </section>
  <Fragment slot="footer">
    <slot name="footer" />
  </Fragment>
</Layout>
