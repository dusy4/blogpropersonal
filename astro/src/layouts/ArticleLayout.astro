---
import Layout from './Layout.astro';
import Share from '../components/Share.astro';
import TelegramIcon from '../components/TelegramIcon.astro';
import TelegramPlaneIcon from '../components/TelegramPlaneIcon.astro';
import { TELEGRAM_CHANNEL_URL, SITE_URL } from '../config';
import '../styles/article.css';

export interface Props {
  title: string;
  date: Date;
  author: string;
  keyTakeaways: string;
  slug: string;
  image?: string;
}

const { title, date, author, keyTakeaways, slug, image } = Astro.props;
const url = `${SITE_URL}/articles/${slug}`;
const dateIso = date.toISOString();
const imageUrl = image ? new URL(image, `${SITE_URL}/`).toString() : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  author: { '@type': 'Person', name: author },
  datePublished: dateIso,
  description: keyTakeaways,
  ...(imageUrl ? { image: imageUrl } : {}),
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};
---

<Layout title={title} description={keyTakeaways}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Fragment slot="header"><slot name="header" /></Fragment>

  <section class="article-shell">
    <article class="article-body prose max-w-none prose-headings:text-slate-900 prose-a:text-brand md:prose-lg">
      <h1>{title}</h1>
      <div class="article-meta">
        <span>{author}</span><span>•</span><time datetime={dateIso}>{date.toLocaleDateString('uk-UA')}</time>
      </div>

      {image && <img class="article-cover" src={image} alt={title} loading="eager" decoding="async" />}

      <aside class="key-takeaways" aria-labelledby="key-takeaways-title">
        <h2 id="key-takeaways-title">Ключові висновки</h2>
        <p>{keyTakeaways}</p>
      </aside>

      <slot />
    </article>

    <aside class="article-telegram" aria-label="Telegram">
      <div class="telegram-copy">
        <div class="telegram-mark" aria-hidden="true">
          <TelegramIcon size={25} />
        </div>
        <h3>Приєднуйтесь до нашого <span>Telegram</span>-каналу</h3>
        <p>Отримуйте новини про AI-інтеграції, кейси та практичні інсайти.</p>
        <a href={TELEGRAM_CHANNEL_URL} target="_blank" rel="noopener" class="telegram-cta-button">
          <TelegramPlaneIcon size={18} />
          <span>Перейти в Telegram</span>
          <b aria-hidden="true">→</b>
        </a>
      </div>
      <div class="telegram-visual" aria-hidden="true">
        <div class="telegram-orb">
          <TelegramIcon size={170} />
        </div>
      </div>
    </aside>

    <div class="article-share"><Share url={url} title={title} /></div>
  </section>

  <Fragment slot="footer"><slot name="footer" /></Fragment>
</Layout>
