---
import Layout from './Layout.astro';
import Share from '../components/Share.astro';
import { TELEGRAM_CHANNEL_URL, SITE_URL } from '../config';
import '../styles/article.css';

export interface Props {
  title: string;
  date: Date;
  author: string;
  keyTakeaways: string;
  slug: string;
}

const { title, date, author, keyTakeaways, slug } = Astro.props;
const url = `${SITE_URL}/articles/${slug}`;
const dateIso = date.toISOString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  author: { '@type': 'Person', name: author },
  datePublished: dateIso,
  description: keyTakeaways,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};
---

<Layout title={title} description={keyTakeaways}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Fragment slot="header"><slot name="header" /></Fragment>

  <section class="article-shell">
    <article class="article-body prose max-w-none prose-headings:text-slate-900 prose-a:text-brand md:prose-lg">
      <h1>{title}</h1>
      <div class="article-meta">
        <span>{author}</span><span>•</span><time datetime={dateIso}>{date.toLocaleDateString('uk-UA')}</time>
      </div>

      <div class="key-takeaways">
        <h2>Ключові висновки</h2>
        <p>{keyTakeaways}</p>
      </div>

      <slot />
    </article>

    <div class="article-telegram rounded-2xl bg-brand p-8 text-white">
      <h3 class="m-0 text-xl font-semibold">Приєднуйтесь до нашого Telegram-каналу</h3>
      <p class="mt-2 text-slate-100">Отримуйте новини про AI-інтеграції, кейси та практичні інсайти.</p>
      <a href={TELEGRAM_CHANNEL_URL} target="_blank" rel="noopener" class="btn-primary mt-4">Перейти в Telegram →</a>
    </div>

    <div class="article-share"><Share url={url} title={title} /></div>
  </section>

  <Fragment slot="footer"><slot name="footer" /></Fragment>
</Layout>
