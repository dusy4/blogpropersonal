---
import { SITE_NAME, TELEGRAM_CHANNEL_URL } from '../config';
---
<footer class="mt-20 border-t border-slate-200 bg-slate-50">
  <div class="container-site flex flex-col gap-4 py-10 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between">
    <p>© {new Date().getFullYear()} {SITE_NAME}</p>
    <div class="flex gap-5">
      <a href={TELEGRAM_CHANNEL_URL} target="_blank" rel="noopener noreferrer" class="hover:text-slate-950">Telegram</a>
      <a href="/llms.txt" class="hover:text-slate-950">llms.txt</a>
      <a href="/llms-full.txt" class="hover:text-slate-950">llms-full.txt</a>
    </div>
  </div>
</footer>
