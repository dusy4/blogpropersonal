---
import { TELEGRAM_CHANNEL_URL } from '../config';
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-100 bg-white">
  <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-8 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between lg:px-8">
    <p>© {currentYear} ProPersonal Agency</p>
    <div class="flex items-center gap-5">
      <a href="/#articles" class="hover:text-brand">Статті</a>
      <a href="/#cases" class="hover:text-brand">Кейси</a>
      <a href={TELEGRAM_CHANNEL_URL} target="_blank" rel="noopener" class="hover:text-brand">Telegram</a>
    </div>
  </div>
</footer>
