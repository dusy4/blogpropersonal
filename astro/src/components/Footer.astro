---
import { TELEGRAM_CHANNEL_URL, UI } from '../config';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="footer-left">
      <p>placeholder dusy4</p>
      <nav aria-label="Навігація у футері">
        <a href="/#articles">{UI.navArticles}</a>
        <a href="/#cases">{UI.navCases}</a>
        <a href={TELEGRAM_CHANNEL_URL} target="_blank" rel="noopener">Telegram</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer { background:#f8f8f4; border-top:1px solid #e5e7e0; }
  .site-footer__inner {
    color:#727b78;
    width:min(1120px,100% - 40px);
    margin:0 auto;
    padding:22px 0 28px;
  }
  .footer-left>p { margin:0; font-size:11px; }
  .footer-left nav { gap:17px; margin-top:7px; display:flex; }
  .footer-left a { color:#315451; font-size:11px; font-weight:600; }
  .footer-left a:hover { color:#0f4c4d; }
  @media (max-width:700px) {
    .site-footer__inner { width:min(100% - 24px,1120px); }
  }
</style>
