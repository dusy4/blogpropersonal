---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ArticleRow from './ArticleRow.astro';
import { SITE_NAME, SITE_URL } from '../config';
import '../styles/homepage.css';

export interface Props {
  articles: any[];
  currentPage: number;
  totalPages: number;
}

const { articles, currentPage, totalPages } = Astro.props;
const pageHref = (page: number) => page === 1 ? '/articles' : `/articles/page/${page}`;
const canonical = `${SITE_URL}${pageHref(currentPage)}`;
const previousPage = currentPage > 1 ? currentPage - 1 : null;
const nextPage = currentPage < totalPages ? currentPage + 1 : null;

const paginationItems: Array<number | 'ellipsis'> = (() => {
  if (totalPages <= 7) return Array.from({ length: totalPages }, (_, index) => index + 1);

  const visible = new Set([1, totalPages, currentPage - 1, currentPage, currentPage + 1].filter((page) => page >= 1 && page <= totalPages));
  const pages = [...visible].sort((a, b) => a - b);
  const result: Array<number | 'ellipsis'> = [];

  pages.forEach((page, index) => {
    const previous = pages[index - 1];
    if (index > 0 && page - previous > 1) result.push('ellipsis');
    result.push(page);
  });

  return result;
})();
---

<Layout
  title={`Усі статті${currentPage > 1 ? ` — сторінка ${currentPage}` : ''} — ${SITE_NAME}`}
  description="Усі статті про AI-інтеграції, автоматизацію та практичне застосування технологій у бізнесі."
>
  <Fragment slot="head">
    <link rel="canonical" href={canonical} />
    {previousPage && <link rel="prev" href={`${SITE_URL}${pageHref(previousPage)}`} />}
    {nextPage && <link rel="next" href={`${SITE_URL}${pageHref(nextPage)}`} />}
  </Fragment>

  <Header slot="header" />

  <main class="blog-shell archive-shell">
    <section class="content-section archive-section" aria-labelledby="all-articles-title">
      <div class="section-heading archive-heading">
        <div class="section-title">
          <div class="section-title-line">
            <h1 id="all-articles-title">Усі статті</h1>
            <i aria-hidden="true"></i>
          </div>
          <p>Матеріали про AI-інтеграції, автоматизацію та практичне застосування технологій.</p>
        </div>
      </div>

      <div class="articles-layout no-visual">
        <div class="article-list">
          {articles.length
            ? articles.map((post) => <ArticleRow post={post} />)
            : <div class="empty-list">Статей поки немає.</div>}
        </div>
      </div>

      {totalPages > 1 && (
        <nav class="pagination" aria-label="Пагінація статей">
          {previousPage ? (
            <a class="pagination-direction" href={pageHref(previousPage)} rel="prev">
              <span aria-hidden="true">←</span> Попередня
            </a>
          ) : (
            <span class="pagination-direction is-disabled" aria-disabled="true"><span aria-hidden="true">←</span> Попередня</span>
          )}

          <div class="pagination-pages">
            {paginationItems.map((item) => item === 'ellipsis' ? (
              <span class="pagination-ellipsis" aria-hidden="true">…</span>
            ) : (
              <a
                class:list={['pagination-page', item === currentPage && 'is-current']}
                href={pageHref(item)}
                aria-current={item === currentPage ? 'page' : undefined}
                aria-label={`Сторінка ${item}`}
              >{item}</a>
            ))}
          </div>

          {nextPage ? (
            <a class="pagination-direction" href={pageHref(nextPage)} rel="next">
              Наступна <span aria-hidden="true">→</span>
            </a>
          ) : (
            <span class="pagination-direction is-disabled" aria-disabled="true">Наступна <span aria-hidden="true">→</span></span>
          )}
        </nav>
      )}
    </section>
  </main>

  <Footer slot="footer" />
</Layout>

<style>
  .archive-shell { padding-top:18px; padding-bottom:46px; }
  .archive-section { padding-top:22px; }
  .archive-heading { margin-bottom:17px; }
  .archive-heading .section-title h1 {
    margin:0;
    color:#0c3534;
    font-size:30px;
    line-height:1;
    font-weight:700;
  }
  .pagination {
    display:grid;
    grid-template-columns:minmax(120px,1fr) auto minmax(120px,1fr);
    align-items:center;
    gap:20px;
    margin-top:30px;
    padding-top:20px;
    border-top:1px solid #e2e5df;
  }
  .pagination-pages { display:flex; align-items:center; justify-content:center; gap:7px; }
  .pagination-page,
  .pagination-direction {
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:38px;
    border:1px solid #dbe4df;
    background:#fff;
    color:#315451;
    font-size:13px;
    font-weight:700;
    transition:background .16s ease,border-color .16s ease,color .16s ease;
  }
  .pagination-page { min-width:38px; padding:0 10px; border-radius:999px; }
  .pagination-direction { width:max-content; gap:8px; padding:0 13px; border-radius:9px; }
  .pagination-direction:last-child { justify-self:end; }
  .pagination-page:hover,
  .pagination-direction:hover { background:#eef6f2; border-color:#b9d4c8; color:#0f4c4d; }
  .pagination-page.is-current { background:#0f4c4d; border-color:#0f4c4d; color:#fff; }
  .pagination-direction.is-disabled { opacity:.42; cursor:default; }
  .pagination-ellipsis { min-width:26px; text-align:center; color:#89928f; }

  @media(max-width:700px) {
    .archive-shell { padding-top:8px; }
    .archive-heading .section-title h1 { font-size:clamp(2rem,10vw,2.6rem); }
    .pagination { grid-template-columns:1fr 1fr; gap:12px; }
    .pagination-pages { grid-column:1 / -1; grid-row:1; flex-wrap:wrap; }
    .pagination-direction { grid-row:2; }
    .pagination-direction:last-child { justify-self:end; }
  }

  @media(max-width:430px) {
    .pagination-direction { min-width:0; padding:0 10px; font-size:12px; }
    .pagination-page { min-width:36px; min-height:36px; }
  }
</style>
