---
import { TELEGRAM_CHANNEL_URL } from '../config';
---

<header class="sticky top-0 z-50 border-b border-slate-100 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 lg:px-8">
    <a href="/" class="flex items-center gap-2 text-xl font-bold text-brand">
      <span class="flex h-8 w-8 items-center justify-center rounded bg-brand text-sm text-white">PA</span>
      ProPersonal
    </a>

    <nav class="flex items-center gap-5 sm:gap-7" aria-label="Main navigation">
      <a href="/#articles" class="text-sm font-medium text-slate-700 hover:text-brand">Статті</a>
      <a href="/#cases" class="text-sm font-medium text-slate-700 hover:text-brand">Кейси</a>
      <a href={TELEGRAM_CHANNEL_URL} target="_blank" rel="noopener" class="btn-primary !px-4 !py-2 text-sm">Telegram</a>
    </nav>
  </div>
</header>
