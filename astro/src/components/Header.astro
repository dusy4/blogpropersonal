---
import { TELEGRAM_CHANNEL_URL, CONTACT_EMAIL } from '../config';

const nav = [
  { href: '/', label: 'Головна' },
  { href: '/articles', label: 'Блог' },
  { href: '/cases', label: 'Кейси' },
  { href: '/#contact', label: 'Контакти' },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-slate-100">
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <div class="hidden items-center justify-between border-b border-slate-100 py-2 text-sm text-slate-500 md:flex">
      <div class="flex items-center gap-4">
        <a href="tel:+380000000000" class="hover:text-brand">+38 (000) 000-00-00</a>
        <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-brand">{CONTACT_EMAIL}</a>
      </div>
      <div class="flex items-center gap-4">
        <span class="text-xs">м. Київ, вул. Прикладна 1</span>
      </div>
    </div>
    <div class="flex items-center justify-between py-4">
      <a href="/" class="flex items-center gap-2 text-xl font-bold text-brand">
        <span class="flex h-8 w-8 items-center justify-center rounded bg-brand text-white text-sm">PA</span>
        ProPersonal
      </a>
      <nav class="hidden items-center gap-8 md:flex">
        {nav.map((item) => (
          <a href={item.href} class="text-sm font-medium text-slate-700 hover:text-brand transition-colors">{item.label}</a>
        ))}
      </nav>
      <a href={TELEGRAM_CHANNEL_URL} target="_blank" rel="noopener" class="btn-primary text-sm">Telegram</a>
    </div>
  </div>
</header>
