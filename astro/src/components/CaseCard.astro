---
interface Props {
  title: string;
  slug: string;
  description: string;
  result?: string;
  client?: string;
}
const { title, slug, description, result, client } = Astro.props;
---
<article class="card flex h-full flex-col p-6">
  <p class="eyebrow">{client || 'Case study'}</p>
  <h3 class="mt-3 text-xl font-bold tracking-tight text-slate-950">
    <a href={`/cases/${slug}`} class="hover:text-blue-700">{title}</a>
  </h3>
  <p class="mt-3 text-sm leading-6 text-slate-600">{description}</p>
  {result && <p class="mt-4 rounded-xl bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-900">{result}</p>}
  <a href={`/cases/${slug}`} class="mt-auto pt-6 text-sm font-semibold text-blue-700">Дивитися кейс →</a>
</article>
