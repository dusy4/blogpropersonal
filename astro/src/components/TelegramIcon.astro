---
export interface Props {
  size?: number | string;
  class?: string;
  title?: string;
}

const { size = 20, class: className, title } = Astro.props;
---

<svg
  class:list={['telegram-icon', className]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  {title && <title>{title}</title>}
  <path d="M9.78 18.65 10.06 14.42 17.74 7.5c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42Z" />
</svg>

<style>
  .telegram-icon { display:block; flex:none; }
</style>
