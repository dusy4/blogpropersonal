---
export interface Props {
  title: string;
  href: string;
  excerpt: string;
  date: Date;
}

const { title, href, excerpt, date } = Astro.props;
---

<article class="group flex flex-col rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:shadow-md">
  <h3 class="text-lg font-semibold leading-snug text-slate-900 group-hover:text-brand">
    <a href={href}>{title}</a>
  </h3>
  <p class="mt-2 line-clamp-3 text-sm text-muted">{excerpt}</p>
  <div class="mt-auto pt-4 text-xs text-slate-400">
    {date.toLocaleDateString('uk-UA', { day: 'numeric', month: 'long', year: 'numeric' })}
  </div>
</article>
