---
interface Props {
  title: string;
  slug: string;
  date: Date;
  keyTakeaways: string;
  author?: string;
}
const { title, slug, date, keyTakeaways, author } = Astro.props;
---
<article class="card flex h-full flex-col p-6">
  <div class="flex items-center gap-2 text-xs text-slate-500">
    <time datetime={date.toISOString()}>{date.toLocaleDateString('uk-UA')}</time>
    {author && <><span>·</span><span>{author}</span></>}
  </div>
  <h3 class="mt-4 text-xl font-bold tracking-tight text-slate-950">
    <a href={`/articles/${slug}`} class="hover:text-blue-700">{title}</a>
  </h3>
  <p class="mt-3 line-clamp-4 text-sm leading-6 text-slate-600">{keyTakeaways}</p>
  <a href={`/articles/${slug}`} class="mt-auto pt-6 text-sm font-semibold text-blue-700">Читати статтю →</a>
</article>
