---
export const prerender = true;

import { getCollection } from 'astro:content';
import ArticlesArchive from '../../../components/ArticlesArchive.astro';

const PAGE_SIZE = 10;

export async function getStaticPaths() {
  const pageSize = 10;
  const articles = await getCollection('articles');
  const totalPages = Math.max(1, Math.ceil(articles.length / pageSize));

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const pageNumber = index + 2;
    return {
      params: { page: String(pageNumber) },
      props: { pageNumber },
    };
  });
}

const { pageNumber } = Astro.props as { pageNumber: number };
const articles = (await getCollection('articles')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const totalPages = Math.max(1, Math.ceil(articles.length / PAGE_SIZE));
const pageArticles = articles.slice((pageNumber - 1) * PAGE_SIZE, pageNumber * PAGE_SIZE);
---

<ArticlesArchive articles={pageArticles} currentPage={pageNumber} totalPages={totalPages} />
