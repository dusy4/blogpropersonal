export const prerender = true;

---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const articles = await getCollection('articles');
const sorted = articles.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const slugFor = (post: any) => post.data.slug || post.id.replace(/^\d{4}-\d{2}-\d{2}-/, '').replace(/\.md$/, '');
---

<Layout title="Блог — ProPersonal Agency" description="Корисні матеріали про AI-інтеграції, автоматизацію та зростання бізнесу.">
  <Header slot="header" />
  <section class="mx-auto max-w-7xl px-4 py-16 lg:px-8">
    <h1 class="text-4xl font-bold text-brand">Блог</h1>
    <p class="mt-4 max-w-2xl text-muted">Дослідження, кейси та практичні поради про те, як AI допомагає бізнесу працюувати швидше та ефективніше.</p>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {sorted.map((post) => (
        <ArticleCard
          title={post.data.title}
          href={`/articles/${slugFor(post)}`}
          excerpt={post.data.keyTakeaways}
          date={new Date(post.data.date)}
        />
      ))}
    </div>
  </section>
  <Footer slot="footer" />
</Layout>
