export const prerender = true;

---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';

const articles = (await getCollection('articles'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const cases = (await getCollection('cases'))
  .sort((a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime());

const slugFor = (entry: any) =>
  entry.data.slug || entry.id.replace(/^\d{4}-\d{2}-\d{2}-/, '').replace(/\.md$/, '');
---

<Layout
  title="Блог — ProPersonal Agency"
  description="Статті та кейси про AI-інтеграції, автоматизацію та практичне застосування AI у бізнесі."
>
  <Header slot="header" />

  <section id="articles" class="bg-white py-14 md:py-16">
    <div class="mx-auto max-w-7xl px-4 lg:px-8">
      <div class="max-w-2xl">
        <h1 class="text-4xl font-bold text-brand md:text-5xl">Блог</h1>
        <p class="mt-4 text-muted">Статті та практичні матеріали про AI-інтеграції й автоматизацію.</p>
      </div>

      <div class="mt-10 flex items-end justify-between gap-4">
        <h2 class="text-2xl font-bold text-brand md:text-3xl">Статті</h2>
        <a href="/articles" class="text-sm font-medium text-brand hover:text-brand-light">Усі статті →</a>
      </div>

      {articles.length === 0 ? (
        <div class="mt-8 rounded-2xl border border-slate-200 bg-surface p-10 text-center">
          <p class="text-muted">Статей ще немає.</p>
        </div>
      ) : (
        <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {articles.map((post) => (
            <ArticleCard
              title={post.data.title}
              href={`/articles/${slugFor(post)}`}
              excerpt={post.data.keyTakeaways}
              date={new Date(post.data.date)}
            />
          ))}
        </div>
      )}
    </div>
  </section>

  <section id="cases" class="border-t border-slate-100 bg-surface py-14 md:py-16">
    <div class="mx-auto max-w-7xl px-4 lg:px-8">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold text-brand md:text-3xl">Кейси</h2>
          <p class="mt-3 text-muted">Практичні приклади реалізованих AI-рішень та автоматизацій.</p>
        </div>
        <a href="/cases" class="text-sm font-medium text-brand hover:text-brand-light">Усі кейси →</a>
      </div>

      {cases.length === 0 ? (
        <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-10 text-center">
          <p class="text-muted">Кейсів ще немає.</p>
        </div>
      ) : (
        <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {cases.map((entry) => (
            <article class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
              {entry.data.image && (
                <img src={entry.data.image} alt={entry.data.title} class="h-44 w-full object-cover" />
              )}
              <div class="p-6">
                <h3 class="text-lg font-semibold text-brand">{entry.data.title}</h3>
                {entry.data.client && <p class="mt-1 text-sm text-muted">{entry.data.client}</p>}
                <p class="mt-3 text-sm leading-6 text-muted">{entry.data.description}</p>
                {entry.data.result && (
                  <div class="mt-4 rounded-lg bg-surface p-3 text-sm text-slate-700">
                    <span class="font-semibold text-brand">Результат:</span> {entry.data.result}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
