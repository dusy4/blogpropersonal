export const prerender = true;

---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const articles = (await getCollection('articles'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const cases = (await getCollection('cases'))
  .sort((a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime());

const slugFor = (entry: any) =>
  entry.data.slug || entry.id.replace(/^\d{4}-\d{2}-\d{2}-/, '').replace(/\.md$/, '');

const featured = articles[0];
const rest = articles.slice(1);
---

<Layout
  title="Блог — ProPersonal Agency"
  description="Статті та кейси про AI-інтеграції, автоматизацію та практичне застосування AI у бізнесі."
>
  <Header slot="header" />

  <main class="mx-auto w-full max-w-7xl px-4 py-12 lg:px-8 lg:py-16">
    <header class="max-w-3xl">
      <h1 class="text-4xl font-bold text-brand md:text-5xl">Блог</h1>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-muted">
        Статті та кейси про AI-інтеграції й автоматизацію.
      </p>
    </header>

    <section id="articles" aria-labelledby="articles-title" class="mt-14 scroll-mt-24">
      <div class="flex items-end justify-between gap-4 border-b border-slate-200 pb-4">
        <h2 id="articles-title" class="text-2xl font-bold text-brand md:text-3xl">Статті</h2>
        <a href="/articles" class="text-sm font-medium text-brand hover:text-brand-light">Усі статті →</a>
      </div>

      {featured ? (
        <>
          <article class="mt-8 grid gap-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:grid-cols-[minmax(0,2fr)_minmax(220px,1fr)] md:p-8">
            <div>
              <p class="text-sm text-muted">
                <time datetime={new Date(featured.data.date).toISOString()}>
                  {new Date(featured.data.date).toLocaleDateString('uk-UA', { day: 'numeric', month: 'long', year: 'numeric' })}
                </time>
              </p>
              <h3 class="mt-3 text-3xl font-bold leading-tight text-slate-950 md:text-4xl">
                <a href={`/articles/${slugFor(featured)}`} class="hover:text-brand-light">{featured.data.title}</a>
              </h3>
              <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">{featured.data.keyTakeaways}</p>
              <a href={`/articles/${slugFor(featured)}`} class="mt-6 inline-block text-sm font-semibold text-brand hover:text-brand-light">
                Читати статтю →
              </a>
            </div>
            <div class="flex items-end rounded-xl bg-surface p-5">
              <p class="text-sm leading-6 text-slate-600">
                Остання публікація. Повний матеріал відкривається окремою статичною сторінкою з Key Takeaways, основним текстом та кнопками поширення.
              </p>
            </div>
          </article>

          {rest.length > 0 && (
            <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {rest.map((post) => (
                <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                  <p class="text-xs text-slate-500">
                    <time datetime={new Date(post.data.date).toISOString()}>
                      {new Date(post.data.date).toLocaleDateString('uk-UA')}
                    </time>
                  </p>
                  <h3 class="mt-3 text-xl font-semibold leading-snug text-slate-950">
                    <a href={`/articles/${slugFor(post)}`} class="hover:text-brand">{post.data.title}</a>
                  </h3>
                  <p class="mt-3 line-clamp-4 text-sm leading-6 text-muted">{post.data.keyTakeaways}</p>
                  <a href={`/articles/${slugFor(post)}`} class="mt-5 inline-block text-sm font-semibold text-brand hover:text-brand-light">
                    Читати →
                  </a>
                </article>
              ))}
            </div>
          )}
        </>
      ) : (
        <p class="mt-8 rounded-2xl border border-slate-200 bg-surface p-8 text-muted">Статей ще немає.</p>
      )}
    </section>

    <section id="cases" aria-labelledby="cases-title" class="mt-16 scroll-mt-24">
      <div class="flex items-end justify-between gap-4 border-b border-slate-200 pb-4">
        <div>
          <h2 id="cases-title" class="text-2xl font-bold text-brand md:text-3xl">Кейси</h2>
          <p class="mt-2 text-sm text-muted">Практичні приклади AI-рішень та автоматизацій.</p>
        </div>
        <a href="/cases" class="text-sm font-medium text-brand hover:text-brand-light">Усі кейси →</a>
      </div>

      {cases.length > 0 ? (
        <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {cases.map((entry) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              {entry.data.client && <p class="text-xs font-medium uppercase tracking-wide text-slate-500">{entry.data.client}</p>}
              <h3 class="mt-2 text-xl font-semibold leading-snug text-slate-950">{entry.data.title}</h3>
              <p class="mt-3 text-sm leading-6 text-muted">{entry.data.description}</p>
              {entry.data.result && (
                <p class="mt-4 border-l-2 border-accent pl-4 text-sm font-medium leading-6 text-slate-700">
                  {entry.data.result}
                </p>
              )}
            </article>
          ))}
        </div>
      ) : (
        <p class="mt-8 rounded-2xl border border-slate-200 bg-surface p-8 text-muted">Кейсів ще немає.</p>
      )}
    </section>
  </main>

  <Footer slot="footer" />
</Layout>
