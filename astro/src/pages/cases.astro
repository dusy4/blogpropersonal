export const prerender = true;

---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const cases = await getCollection('cases');
const sorted = cases.sort((a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime());
---

<Layout title="Кейси — ProPersonal Agency" description="Реальні кейси впровадження AI та автоматизації для бізнесу.">
  <Header slot="header" />
  <section class="mx-auto max-w-7xl px-4 py-16 lg:px-8">
    <h1 class="text-4xl font-bold text-brand">Кейси</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Приклади реалізацій, де AI та автоматизація допомогли клієнтам зростати швидше, зменшити витрати та покращити досвід їхніх клієнтів.
    </p>

    {sorted.length === 0 ? (
      <div class="mt-12 rounded-2xl border border-slate-200 bg-white p-12 text-center">
        <p class="text-muted">Ще немає опублікованих кейсів. Скоро додамо перші приклади.</p>
      </div>
    ) : (
      <div class="mt-10 grid gap-8 md:grid-cols-2">
        {sorted.map((c) => (
          <article class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
            {c.data.image && (
              <img src={c.data.image} alt={c.data.title} class="h-48 w-full object-cover" />
            )}
            <div class="p-6">
              <h2 class="text-xl font-semibold text-brand">{c.data.title}</h2>
              {c.data.client && <p class="mt-1 text-sm text-muted">{c.data.client}</p>}
              <p class="mt-3 text-muted">{c.data.description}</p>
              {c.data.result && (
                <div class="mt-4 rounded-lg bg-surface p-3 text-sm text-slate-700">
                  <span class="font-semibold text-brand">Результат:</span> {c.data.result}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
  <Footer slot="footer" />
</Layout>
