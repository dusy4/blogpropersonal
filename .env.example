# Vercel Production Environment Variables
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=blogpropersonal
GITHUB_BRANCH=main
WEBHOOK_SECRET=
SETUP_SECRET=

# Telegram access
# ADMIN_ID is always allowed and is the only user who sees the full status screen.
ADMIN_ID=
# 0 = anyone may use the bot. Otherwise comma-separated Telegram user IDs.
TELEGRAM_ALLOWED_USER_IDS=0
# Explicit private/public source channel IDs allowed to auto-publish channel_post updates.
# Example: -1001234567890,-1009876543210
TELEGRAM_SOURCE_CHANNEL_IDS=

# Site / handoff configuration
SITE_URL=https://example.com
SITE_NAME=ProPersonal
SITE_MARK=PP
BLOG_SUBTITLE=Блог про AI-інтеграції та автоматизацію
SITE_DESCRIPTION=Практичні статті та кейси про AI-інтеграції й автоматизацію.
# Public Telegram channel used by website CTA/header/footer. Separate from source channels above.
TELEGRAM_CHANNEL_URL=https://t.me/example
CONTACT_EMAIL=hello@example.com
DEFAULT_AUTHOR=Pro Personal Agency

# Archive destinations. CASES_URL may be an external portfolio URL.
ARTICLES_URL=/articles
CASES_URL=/cases

# Normally leave these unchanged unless the repo structure changes.
ARTICLE_PATH=astro/src/content/articles
CASE_PATH=astro/src/content/cases
