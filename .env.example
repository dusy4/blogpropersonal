# Vercel Production Environment Variables
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=blogpropersonal
GITHUB_BRANCH=main
WEBHOOK_SECRET=
SETUP_SECRET=

# Telegram access
# Main user access control:
# 0 = anyone may use the bot CMS.
# Otherwise comma-separated Telegram user IDs, e.g. 111111111,222222222
TELEGRAM_ALLOWED_USER_IDS=0

# Source channel access control:
# 0 = any channel where the bot receives channel_post updates may auto-publish.
# Otherwise comma-separated Telegram channel IDs, e.g. -1001234567890,-1009876543210
TELEGRAM_SOURCE_CHANNEL_IDS=0

# Optional diagnostics/backward-compatibility owner.
# Not required for publication access when TELEGRAM_ALLOWED_USER_IDS is configured.
ADMIN_ID=

# Site / handoff configuration
# Normally leave SITE_URL unset on Vercel. The app derives the production domain from
# VERCEL_PROJECT_PRODUCTION_URL automatically, including the project's production custom domain.
# Set SITE_URL only if you intentionally want to override Vercel's resolved production domain.
# SITE_URL=https://example.com
SITE_NAME=ProPersonal
SITE_MARK=PP
BLOG_SUBTITLE=Блог про AI-інтеграції та автоматизацію
SITE_DESCRIPTION=Практичні статті та кейси про AI-інтеграції й автоматизацію.
# Public Telegram channel used by website CTA/header/footer. Separate from source channels above.
TELEGRAM_CHANNEL_URL=https://t.me/example
CONTACT_EMAIL=hello@example.com
DEFAULT_AUTHOR=Pro Personal Agency

# Archive destinations. CASES_URL may be an external portfolio URL.
ARTICLES_URL=/articles
CASES_URL=/cases

# Normally leave these unchanged unless the repo structure changes.
ARTICLE_PATH=astro/src/content/articles
CASE_PATH=astro/src/content/cases
